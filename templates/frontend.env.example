# This file is compiled into browser code. It must contain public values only.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_ENV=local
VITE_ENABLE_AI_UI=false

# Optional only if Supabase browser Auth is deliberately implemented.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER add DATABASE_URL, database passwords, OpenAI keys, or Supabase secret/service-role keys here.

