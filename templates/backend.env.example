# Safe example only. Copy to backend/.env; never commit the real file.
APP_NAME=ASO Compass API
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Copy the correct direct or session-pooler connection from Supabase Connect.
# For Psycopg 3/SQLAlchemy, adapt the scheme to postgresql+psycopg as needed.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<percent-encoded-password>@<pooler-host>:5432/postgres?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=15

FRONTEND_ORIGINS=http://localhost:5173

OPEN_TARGETS_URL=https://api.platform.opentargets.org/api/v4/graphql
CLINICAL_TRIALS_URL=https://clinicaltrials.gov/api/v2/studies
HTTP_TIMEOUT_SECONDS=60
HTTP_RETRY_TOTAL=4
CACHE_TTL_HOURS=24

MAX_ACTIVE_RUNS=1
MAX_QUEUED_RUNS=10
MAX_RUN_MINUTES=25
ANONYMOUS_RUN_RETENTION_DAYS=14

AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_SECONDS=45
AI_RATE_LIMIT_PER_MINUTE=6

# Add Supabase Auth/Storage variables only when those features are implemented.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
