# Safe example. Never commit backend/.env.
APP_ENV=local
DATABASE_URL=sqlite:///./aso_compass_local.db
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=15
AI_ENABLED=false
# SHA-256 of the separate GUI access token. Never put the token or this hash in Vite variables.
AI_ACCESS_TOKEN_HASH=
# Backend only. Do not use a VITE_ variable or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_SECONDS=45
AI_RATE_LIMIT_PER_MINUTE=6
RUN_WORKER_ENABLED=true
CREATE_RUN_RATE_LIMIT_PER_MINUTE=12
